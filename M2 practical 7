INTRODUCTION TO APACHE SPARK

Objectives:-

1.Set up Apache Spark locally.
2.Perform word count on a text file using Spark.

PROGRAM :-

from pyspark.sql import SparkSession

spark = SparkSession.builder \
    .appName("Word Count") \
    .master("local[*]") \
    .getOrCreate()

sc = spark.sparkContext

data = [
    "Scala is powerful",
    "Spark is fast",
    "Big data is great",
    "Scala works well"
]

text = sc.parallelize(data)

wordCount = (text.flatMap(lambda line: line.split())
             .map(lambda word: (word, 1))
             .reduceByKey(lambda a, b: a + b))

print("Word Count")

for word, count in wordCount.collect():
    print(f"{word}: {count}")

spark.stop()


